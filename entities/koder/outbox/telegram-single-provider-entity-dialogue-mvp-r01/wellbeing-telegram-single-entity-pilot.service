[Unit]
Description=Wellbeing Telegram single-Entity closed pilot r0.1
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wellbeing-tg-dialog
Group=wellbeing-tg-dialog
UMask=0077
WorkingDirectory=/opt/wellbeing/telegram-single-entity-mvp-r01
ExecStart=/usr/bin/python3 -I -B /opt/wellbeing/telegram-single-entity-mvp-r01/dialogue_mvp.py poll --config /etc/wellbeing/telegram-single-entity-pilot/runtime.json
LoadCredential=telegram_bot_token:/etc/wellbeing/telegram-single-entity-pilot/secrets/telegram_bot_token
LoadCredential=openai_api_key:/etc/wellbeing/telegram-single-entity-pilot/secrets/openai_api_key
StateDirectory=wellbeing/telegram-single-entity-pilot
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/wellbeing/telegram-single-entity-pilot
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitCORE=0
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
