          "reason_id",
          "predicate_id",
          "evidence_ref",
          "scope",
          "provenance"
        ],
        "properties": {
          "reason_id": {
            "type": "string"
          },
          "predicate_id": {
            "type": "string"
          },
          "evidence_ref": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "provenance": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "effect_decision": {
      "enum": [
        "ADMIT",
        "REJECT",
        "STOP",
        "NO_EFFECT"
      ]
    },
    "terminal_class": {
      "enum": [
        "PASS",
        "BLOCKED",
        "FAIL",
        "UNKNOWN"
      ]
    },
    "classified_result_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "classified_result_state": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ]
    },
    "synthetic_event_or_result_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "synthetic_event_or_result_type": {
      "enum": [
        "ACTION_EVENT",
        "RESULT",
        "EVENT",
        "NONE"
      ]
    },
    "synthetic_event_or_result_verification_state": {
      "enum": [
        "VERIFIED",
        "UNVERIFIED",
        "UNKNOWN",
        "CONFLICT",
        "NOT_APPLICABLE"
      ]
    },
    "next_gate_class": {
      "enum": [
        "NONE",
        "STOP",
        "REQUEST_EVIDENCE",
        "REQUEST_AUTHORITY",
        "WRITER_GATE",
        "CURRENTNESS_RECONCILIATION",
        "CAUSAL_NEXT_GATE"
      ]
    },
    "next_gate_derivation_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "expected_vs_actual": {
      "type": "object",
      "required": [
        "oracle_state",
        "mismatches"
      ],
      "properties": {
        "oracle_state": {
          "enum": [
            "ORACLE_PASS",
            "ORACLE_FAIL"
          ]
        },
        "mismatches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "expected",
              "actual"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "expected": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              "actual": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
